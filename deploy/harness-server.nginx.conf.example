# Replace the hostname and certificate paths with this device's values.
server {
    listen 443 ssl;
    server_name harness.example.com;
    ssl_certificate /etc/letsencrypt/live/harness.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/harness.example.com/privkey.pem;
    client_max_body_size 12m;
    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Anybox-Instance-Id $http_x_anybox_instance_id;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }
}
