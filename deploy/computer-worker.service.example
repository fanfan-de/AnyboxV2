# Independent user service. Keep this unit outside the harness server's cgroup.
# The directory must match ${ANYBOX_HARNESS_DATABASE}.computer-worker.
[Unit]
Description=Anybox Harness local computer worker
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/anybox-app
ExecStart=%h/anybox-app/runtime/anybox computer-worker serve %h/.local/share/anybox/harness.sqlite.computer-worker
Environment=ANYBOX_SYSTEM_SERVICE_ROLE=computer-worker
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=infinity
UMask=0077

[Install]
WantedBy=default.target
