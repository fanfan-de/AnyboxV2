# User service; requires an unlocked Secret Service in this user's D-Bus session.
[Unit]
Description=Anybox Harness
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/anybox-app
ExecStart=/usr/bin/node %h/anybox-app/dist/host/harness-main.js
Environment=ANYBOX_HARNESS_BIND=127.0.0.1
Environment=ANYBOX_HARNESS_PORT=3001
Environment=ANYBOX_HARNESS_DATABASE=%h/.local/share/anybox/harness.sqlite
Environment=ANYBOX_MODELS_DATABASE=%h/.local/share/anybox/models.sqlite
Environment=ANYBOX_MODELS_CATALOG_DATABASE=%h/.local/share/anybox/models-catalog.sqlite
Environment=ANYBOX_IMAGE_ASSETS_DIRECTORY=%h/.local/share/anybox/images
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=90
UMask=0077

[Install]
WantedBy=default.target
