{
  "name": "@anybox/app-claude-agent",
  "version": "0.1.10",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "web",
    "anybox.app.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-web-vendors.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "peerDependencies": {
    "@nya/core": "^0.1.0-rc.1"
  },
  "dependencies": {
    "@anybox/application-api": "0.1.0",
    "@anybox/directory-picker": "0.1.0",
    "@anybox/storage-sqlite": "0.1.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.301",
    "@anybox/api-key-manager": "0.1.0",
    "@napi-rs/keyring": "2.1.0",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0"
  },
  "devDependencies": {
    "@types/mdast": "4.0.4",
    "esbuild": "0.28.2"
  },
  "bin": {
    "anybox-claude-agent": "./dist/main.js"
  }
}
