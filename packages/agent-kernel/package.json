{
  "name": "@anybox/agent-kernel",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "default": "./dist/contracts.js"
    },
    "./spi": {
      "types": "./dist/spi.d.ts",
      "default": "./dist/spi.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build --workspace @anybox/application && npm run build && node --test tests/*.test.mjs",
    "prebuild": "npm run build --workspace @anybox/agent-contracts",
    "pretypecheck": "npm run build --workspace @anybox/agent-contracts"
  },
  "dependencies": {
    "@nya/core": "file:../../../NyaCore/packages/core",
    "@anybox/agent-contracts": "0.0.0"
  },
  "devDependencies": {
    "@anybox/application": "0.0.0"
  }
}
