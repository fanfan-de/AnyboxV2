        <mxCell id="dSourceOwnershipBody" parent="dSourceOwnership" vertex="1" value="外部身份按 sourceId + 原始 Provider / Model ID 隔离，不按名称或 hostname 合并。&#10;刷新只修改来源拥有的定义，来源缺失仍保留不可变历史。&#10;已有配置的名称、启停、远端 ID、固定定义版本、能力与参数不被自动覆盖。&#10;连接地址、Key、Session 选模与在途 execution 保持既有值。&#10;来源账本已接纳版本为启动权威；缓存与随包候选不能让它倒退。&#10;来源接纳成功与各连接初始化失败分别报告。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=18;fontColor=#183153;align=left;verticalAlign=middle;spacing=18;rounded=0;spacing=0;fontSize=18;fontColor=#183153;fontStyle=0;align=left;verticalAlign=top;connectable=0;">
          <mxGeometry x="20" y="102" width="1020" height="144" as="geometry" />
        </mxCell>
        <mxCell id="dMigration" parent="1" vertex="1" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#F7F2FC;strokeColor=#8053B1;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=18;fontColor=#183153;align=left;verticalAlign=middle;spacing=18;">
          <mxGeometry x="1220" y="1430" width="1060" height="260" as="geometry" />
        </mxCell>
        <mxCell id="dMigrationTitle" parent="dMigration" vertex="1" value="持久化升级与兼容身份" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=18;fontColor=#183153;align=left;verticalAlign=middle;spacing=18;rounded=0;spacing=0;fontSize=24;fontColor=#8053B1;fontStyle=1;align=left;verticalAlign=top;connectable=0;">
          <mxGeometry x="20" y="18" width="1020" height="34" as="geometry" />
        </mxCell>
        <mxCell id="dMigrationSubtitle" parent="dMigration" vertex="1" value="Models SQLite v1 → v2 · 独占事务迁移，失败整体回滚" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=18;fontColor=#183153;align=left;verticalAlign=middle;spacing=18;rounded=0;spacing=0;fontSize=16;fontColor=#64748B;fontStyle=0;align=left;verticalAlign=top;connectable=0;">
          <mxGeometry x="20" y="60" width="1020" height="28" as="geometry" />
        </mxCell>
        <mxCell id="dMigrationBody" parent="dMigration" vertex="1" value="旧 Provider → ProviderConnection；旧 Model → ModelConfiguration，保留选择 ID。&#10;保留用户参数、版本、时间、启停状态与 Key 引用；每个旧 Model 创建用户定义。&#10;旧明确 catalogRef 迁为待解析外部 Provider 身份；其他来源不推断。&#10;历史记录在读取边界转换，迁移不访问或复制密钥。&#10;新 execution 写 schemaVersion: 2；Session 读取旧快照不重写历史 JSON。&#10;Models 配置库、目录缓存库、Harness 业务库各自独占连接，路径不能相同。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=18;fontColor=#183153;align=left;verticalAlign=middle;spacing=18;rounded=0;spacing=0;fontSize=18;fontColor=#183153;fontStyle=0;align=left;verticalAlign=top;connectable=0;">
          <mxGeometry x="20" y="102" width="1020" height="144" as="geometry" />
        </mxCell>
        <mxCell id="dStamp" parent="1" vertex="1" value="2026-09-28 · 数据记录 ≠ Nya 组件 · 详细公共契约见 packages/models/src/types.ts；协调与接纳见 component.ts" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=18;fontColor=#183153;align=left;verticalAlign=middle;spacing=18;rounded=0;spacing=0;fontSize=14;fontColor=#64748B;fontStyle=0;align=left;verticalAlign=top;connectable=0;">
