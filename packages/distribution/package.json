{
  "name": "@anybox/distribution",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@anybox/host": "0.1.0",
    "@anybox/application-api": "0.1.0",
    "@anybox/app-harness": "0.1.1",
    "@anybox/app-claude-agent": "0.1.10",
    "@anybox/storage-sqlite": "0.1.0",
    "@anybox/directory-picker": "0.1.0",
    "@anybox/api-key-manager": "0.1.0",
    "@anybox/models": "0.2.0",
    "sharp": "0.35.5"
  },
  "peerDependencies": {
    "@nya/core": "^0.1.0-rc.1",
    "electron": "44.5.1"
  },
  "devDependencies": {
    "electron": "44.5.1"
  },
  "peerDependenciesMeta": {
    "electron": {
      "optional": true
    }
  }
}
