        <mxCell id="hostClose" value="&lt;div style=&quot;text-align:left;line-height:25px&quot;&gt;&lt;div style=&quot;font-size:22px;line-height:26px;margin-bottom:6px;font-weight:500;color:#2757A5&quot;&gt;整根关闭 / 强制退出&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:25px;color:#203149;margin:0&quot;&gt;宿主先关闭控制、HTTP 与新 Run 准入&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:25px;color:#203149;margin:0&quot;&gt;排空已接受写入，再 dispose 根 Fiber&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:25px;color:#203149;margin:0&quot;&gt;等待请求、工具、凭据、目录及 SQLite&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:25px;color:#203149;margin:0&quot;&gt;异常退出遗留 Run 下次启动 interrupted&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:25px;color:#203149;margin:0&quot;&gt;不自动重放外部副作用&lt;/div&gt;&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=0;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;fontFamily=PingFang SC;" source_file="src/host/execution.ts">
