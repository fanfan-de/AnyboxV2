flowchart TB
    browser["浏览器客户端：工作区、会话、模型设置、Prompt 与草稿"]
    startup["宿主入口：src/web/serve.ts；配置、AgentDefinition、根装配与信号"]
    subgraph root["本机 Node 进程：唯一 Nya 根 Context"]
        web["web-frontend：静态页面、HTTP API、SSE"]
        picker["host-directory-picker：本机目录对话框"]
        subgraph harness["Harness 逻辑边界：16 个现有组件，尚未抽包"]
            run["Run：准入、幂等、模型选择"]
            registry["协议注册与五种绑定：Loop、PreparedRunProgram"]
            runtime["RunRuntime：操作、取消、退出、结算"]
            session["Session：会话树、Run 事实、原生记录与恢复"]
            prompts["Prompt 与 Agent Prompt：草稿、版本、绑定与快照"]
            projects["Projects：项目目录身份"]
            images["Image Assets：原字节、草稿续期与事务保留"]
            files["Project Files：搜索、读取、快照与事务保留"]
            bash["Bash：子进程与实际退出"]
            patch["Apply Patch：串行队列、提交与清理"]
        end
        subgraph modelsGroup["Models 独立模块与 DeepSeek 宿主扩展：11 个组件"]
            models["Models：配置、凭据协调、协议注册与原生 execution"]
            drivers["四种通用原生驱动与 DeepSeek 宿主驱动"]
            store["Models Store：配置、历史与凭据日志"]
            vault["Models Vault：系统凭据操作"]
            catalog["Catalog：Source、Cache、调度与来源接纳"]
        end
        storage["local-sqlite：独占业务连接、事务与迁移机制"]
    end
    businessDb[("harness.sqlite：会话、Run、Prompt、项目、资源引用与文件快照")]
    modelDb[("models.sqlite：模型配置与非秘密引用")]
    catalogDb[("models-catalog.sqlite：公开目录缓存")]
    osVault["操作系统凭据库"]
    imageDirectory["图片组件独占目录"]
    projectDirectory["宿主项目目录与进程"]
    provider["外部 Provider 原生 API"]
    source["外部 models.dev 目录"]
