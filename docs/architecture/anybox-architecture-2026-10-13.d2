# Anybox 架构总览 · 2026-10-13
# 渲染：d2 --layout elk anybox-architecture-2026-10-13.d2 anybox-architecture-2026-10-13.svg
# 容器表示进程或职责分组；每个服务进程只有一个 Nya 根，组件全部安装在根上。
# 实线为主要调用或交接，虚线为数据、配置与资源归属；不枚举全部 inject 依赖。
# 圆柱表示独占持久资源的组件，其标签注明实际文件或目录。

direction: down

vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 0
  }
}

classes: {
  process: {
    style: {
      stroke: "#1f4e79"
      fill: "#f4f8fc"
      stroke-width: 2
      border-radius: 10
      font-size: 22
      bold: true
    }
  }
  group: {
    style: {
      stroke: "#7f93ad"
      fill: "#ffffff"
      stroke-dash: 4
      border-radius: 8
      font-size: 18
      bold: true
    }
  }
  component: {
    style: {
      fill: "#e6eef9"
      stroke: "#3b6ea5"
      border-radius: 6
      font-size: 15
    }
  }
  loop: {
    style: {
      fill: "#e9f5ea"
      stroke: "#3c8a4a"
      border-radius: 6
      font-size: 15
    }
  }
  tool: {
    style: {
      fill: "#fdeedd"
      stroke: "#c8742a"
      border-radius: 6
      font-size: 15
    }
  }
  store: {
    shape: cylinder
    style: {
      fill: "#fff6d6"
      stroke: "#b08a1a"
      font-size: 14
    }
  }
  external: {
    shape: cloud
    style: {
      fill: "#f1f1f1"
      stroke: "#6d6d6d"
      font-size: 15
    }
  }
  note: {
    shape: page
    style: {
      fill: "#fffdf2"
      stroke: "#c2b280"
      font-size: 13
    }
  }
  call: {
    style: {
      stroke: "#2b4c7e"
      stroke-width: 2
      font-size: 13
    }
  }
  data: {
    style: {
      stroke: "#8a7a3a"
      stroke-dash: 5
      font-size: 13
    }
  }
}

title: |md
  # Anybox 架构总览（2026-10-13）
  浏览器外壳 → Anybox Harness 客户端根 → harness server 执行根 → 独立 Computer worker 根
| {
  near: top-center
}

user: 用户 {
  shape: person
  style.font-size: 15
}

desktop: "Electron 主进程（桌面版，可选）\nsrc/entrypoints/desktop-main.ts · src/desktop/\n窗口 · anybox-app:// 协议桥 · 原生目录对话框 · 退出协调\n以 UtilityProcess 托管客户端根与执行端根" {
  class: component
  style.fill: "#f6f0fb"
  style.stroke: "#7b4fa0"
}

# ---------------------------------------------------------------- 展示端
ui: "展示端 · 浏览器 / Electron Renderer\n外壳通过 mount(container, context) 挂载应用界面" {
  class: process
  shell: "Anybox 外壳\nsrc/host/web/\n应用入口条 · #/apps/:appId 路由 · sessionStorage 工作区" {
    class: component
  }
  harness-web: "Anybox Harness 工作区\nsrc/applications/harness/web/\n设备选择 · 项目 · 会话树 · 四分屏 · Models/Prompt 设置" {
    class: component
  }
}

# ---------------------------------------------------------------- 客户端进程
client: "Anybox Harness 客户端进程 · 一个 Nya 根\nsrc/host/client.ts · npm run client" {
  class: process
  resident: "通用宿主常驻" {
    class: group
    client-http: "app.client-http\n回环监听 · 静态页面 · /api/client/v1/apps/:appId 分派" {
      class: component
    }
    products: "app.products / app.activity\n应用目标 · 活动准入" {
      class: component
    }
    storage: "local-storage\nclient.sqlite · 连接与应用目标" {
      class: store
    }
  }
  harness: "打开 Anybox Harness 后装配 · src/applications/harness/client/" {
    class: group
    gateway: "client.gateway\n同源白名单代理 · JSON / 上传 / SSE\n固定连接版本与 instanceId，不跨实例重试" {
      class: component
    }
    connections: "client.connections\n连接地址 · 实例身份 · 凭据引用 · 本机配对\n持久化于 client.sqlite" {
      class: component
    }
    picker: "host.directory-picker\n本机目录对话框" {
      class: component
    }
    gateway -> connections: "读取当前连接" {
      class: call
    }
  }
  resident.client-http -> harness.gateway: "按应用目录分派" {
    class: call
  }
}

# ---------------------------------------------------------------- 执行端进程
execution: "执行端进程 · harness server · 一个 Nya 根（本机或远端，每实例独立）\nsrc/host/execution.ts · src/applications/harness/server*.ts · npm run harness:server" {
  class: process

  host: "通用宿主常驻 · src/host/" {
    class: group
    http: "host.http\n通用监听 · 经 host.access 校验 Bearer · /api/v1/apps/:appId 分派" {
      class: component
    }
    access: "host.access\n实例身份 · 设备令牌摘要" {
      class: component
    }
    products: "app.products / app.activity\n打开目标 · 活动冻结 · Run 停止 guard" {
      class: component
    }
  }

  harness-http: "harness.http · src/applications/harness/http/\n业务 HTTP / SSE · Models 管理路由 · 白名单展示投影" {
    class: component
  }

  core: "harness server 核心 · src/applications/harness/core/" {
    class: group

    runs: "harness.runs / harness.run-admission\n幂等 · 准入 · 准备 program · 取消 / 等待" {
      class: component
    }
    prompts: "harness.prompts / harness.agent-prompts\n草稿 · 发布版本 · Agent 绑定" {
      class: component
    }
    sessions: "harness.sessions / harness.session-runs\n会话 · 节点树 · Run 记录 · 原生记录 · 事件\n接受事务 · 结算事务" {
      class: component
    }
    protocol-agents: "harness.protocol-agents + 四协议绑定\nLoop 1.3.0 · 固定驱动代租约 · PreparedRunProgram" {
      class: loop
    }
    run-runtime: "harness.run-runtime\n独占 program · RunHost.perform() · 操作账本 · 实际退出等待" {
      class: component
    }
    computer: "Computer 协调\nharness.computer-operations · harness.computers · harness.workspaces\ncomputer.worker 客户端 · computer.instance-provider\n声明 / receipt / 结果 · 实例 pin · pinned-local 工作区" {
      class: component
    }
    projects: "harness.projects\n项目目录身份 · 目录浏览" {
      class: component
    }
    project-files: "harness.project-files\n文本搜索 · 文件快照 · 保留凭证" {
      class: component
    }
    image-assets: "harness.image-assets\n不可变原字节 · 导入 / 读取 / 回收\n目录：业务库路径 + .images" {
      class: store
    }
    storage: "local-storage · 业务 SQLite（harness.sqlite）\nrun-state v10 · image-assets · project-files\ncomputers · workspaces · computer-operations" {
      class: store
    }

    runs -> sessions: "幂等查找 · 接受事务 · 结算" {
      class: call
    }
    runs -> prompts: "解析 Prompt" {
      class: call
    }
    runs -> protocol-agents: "准备 program" {
      class: call
    }
    runs -> run-runtime: "start({ runId, program })" {
      class: call
    }
    run-runtime -> protocol-agents: "execute(host) / close()" {
      class: call
    }
    run-runtime -> computer: "工具操作意图 · 观察" {
      class: call
    }
    sessions -> computer: "acceptIn 同事务接纳工具声明" {
      class: call
    }
    sessions -> image-assets: "同事务保留引用" {
      class: call
    }
    sessions -> project-files: "同事务保留引用" {
      class: call
    }
    sessions -> projects: "项目目录身份" {
      class: data
    }
    sessions -> storage: "" {
      class: data
    }
  }

  models: "Models · packages/models（独立可复用包，不导入 src/）" {
    class: group
    core: "models\n提供 models · models.settings · models.protocols · models.source-data\n连接配置队列 · 驱动注册代 · 私有 execution" {
      class: component
    }
    store: "models.store\nJSON 配置：models.json（ANYBOX_MODELS_CONFIG）\n定义 / 连接 / 配置 / 不可变版本" {
      class: store
    }
    vault: "models.vault\n系统凭据，配置只存引用与意图" {
      class: component
    }
    drivers: "原生协议驱动 2.1.0 · 登记到 models.protocols" {
      class: group
      responses: "responses" {
        class: component
      }
      chat: "chat-completions\n（DeepSeek 亦用此协议）" {
        class: component
      }
      anthropic: "anthropic-messages" {
        class: component
      }
      gemini: "gemini-interactions" {
        class: component
      }
    }
    catalog: "models.catalog-source → models.catalog-cache → models.catalog\n匿名目录 · ETag 刷新 · 经 source-data 原子接纳\n缓存：models-catalog.sqlite" {
      class: store
    }
    store -> core: "注入 models.store" {
      class: data
    }
    vault -> core: "注入 models.vault\nopenNative 读取一次凭据" {
      class: data
    }
    drivers -> core: "register(driver)" {
      class: call
    }
    catalog -> core: "source-data 接纳定义" {
      class: call
    }
  }

  host.http -> harness-http: "按应用目录分派" {
    class: call
  }
  harness-http -> core.runs: "startRun / cancelRun / view" {
    class: call
  }
  harness-http -> core.sessions: "会话 · 节点 · 事件查询" {
    class: call
  }
  harness-http -> models.core: "models.settings 管理" {
    class: call
  }
  host.products -> core.runs: "stop guard: pauseIfIdle" {
    class: call
  }
  core.protocol-agents -> models.core: "openNative → 独立 execution" {
    class: call
  }
  host.access -> core.storage: "" {
    class: data
  }
}

# ---------------------------------------------------------------- Computer worker 进程
worker: "独立 Computer worker 进程 · 一个 Nya 根（idle 时继续运行）\nsrc/entrypoints/computer-worker-main.ts · 目录：业务库路径 + .computer-worker" {
  class: process
  executor: "computer.worker 执行器\n耐久账本 · 固定初始化声明 · Run 进程 scope\nworkerId 稳定 · bootId 每次变化" {
    class: component
  }
  bindings: "harness.projects\n固定 workspacePath 绑定，不反查 Authority" {
    class: component
  }
  worker-images: "harness.image-assets\nworker 独占图片目录" {
    class: store
  }
  worker-storage: "local-storage\nworker.sqlite · computer-worker v1" {
    class: store
  }
  tools: "工具组件 · 相对路径基准来自固定绑定" {
    class: group
    bash: "tools.bash" {
      class: tool
    }
    apply-patch: "tools.apply-patch\n跨项目串行队列 · 逐文件提交" {
      class: tool
    }
    processes: "tools.processes\n管道进程组 · write_stdin" {
      class: tool
    }
    files: "tools.files\n读取 · 搜索 · 读图导入" {
      class: tool
    }
  }
  executor -> tools: "固定声明的工具批次" {
    class: call
  }
  executor -> worker-storage: "" {
    class: data
  }
}

# ---------------------------------------------------------------- 外部
network: "进程之外 · 网络与系统" {
  class: group
  style.stroke-dash: 0
  style.fill: "#fafafa"
  model-api: "模型 API\nOpenAI Responses · Chat Completions\nAnthropic · Gemini · DeepSeek" {
    class: external
  }
  models-dev: "models.dev 公开目录\napi.json?type=all" {
    class: external
  }
  keychain: "系统凭据\nmacOS Keychain · Windows Credential Manager\nLinux Secret Service（@napi-rs/keyring）" {
    class: external
  }
}

project-fs: "项目目录（文件系统）\n路径基准，不是沙箱" {
  class: external
}

footer: "图例" {
  near: bottom-center
  grid-rows: 1
  grid-gap: 28
  style.stroke: "#9aa5b1"
  style.fill: "#ffffff"
  style.font-size: 16
  component: "Nya 组件\n安装在所在进程的根" {
    class: component
  }
  loop: "协议 Loop 绑定\nPreparedRunProgram" {
    class: loop
  }
  tool: "工具组件\n仅在 worker 根" {
    class: tool
  }
  store: "独占持久资源的组件\n标签注明文件或目录" {
    class: store
  }
  external: "进程之外的服务" {
    class: external
  }
  lines: "实线：主要调用或交接\n虚线：数据、配置与资源归属\n不枚举全部 inject 依赖" {
    class: note
  }
  nya: "NyaCore · @nya/core（../NyaCore）\n每进程一个根 Context · 组件 inject / provide\napply(ctx, config, deps) · Effect 登记清理 · 依赖就绪与撤销顺序" {
    class: note
  }
}

# ---------------------------------------------------------------- 跨进程边
user -> ui.shell: "" {
  class: call
}
desktop -> ui.shell: "anybox-app:// 窗口\n客户端根与执行端根各为一个 UtilityProcess" {
  class: data
}
ui.harness-web -> client.resident.client-http: "同源 HTTP / SSE" {
  class: call
}
client.harness.gateway -> execution.host.http: "HTTP + Bearer + instanceId\n本机或远端 harness server" {
  class: call
}
client.harness.connections -> network.keychain: "客户端凭据命名空间" {
  class: data
}
execution.models.vault -> network.keychain: "Key 写入 / 读取" {
  class: data
}
execution.models.drivers -> network.model-api: "JSON / SSE 流式" {
  class: call
}
execution.models.catalog -> network.models-dev: "24h ETag 刷新" {
  class: call
}
execution.core.computer -> worker.executor: "本地 HTTP · 声明 / 结果 / 关闭凭证" {
  class: call
}
execution.core.project-files -> project-fs: "只读搜索与快照" {
  class: data
}
worker.tools -> project-fs: "命令 · 补丁 · 读取" {
  class: data
}
