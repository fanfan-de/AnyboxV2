        </mxCell>
        <mxCell id="tree-note" value="&lt;div style=&quot;text-align:left;line-height:1.45;color:#172B4D;&quot;&gt;&lt;div style=&quot;font-size:21px;font-weight:700;color:#172B4D;&quot;&gt;会话树约束&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:10px;&quot;&gt;parentNodeId 必填，可为 null（空会话根）。&lt;br&gt;一轮成功回答形成一个不可变节点。&lt;br&gt;重新生成 / 编辑输入创建兄弟节点。&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#172B4D;fontSize=16;align=left;verticalAlign=middle;spacing=16;fillColor=#F7F9FC;strokeColor=none;strokeWidth=1.2;" vertex="1" parent="1">
