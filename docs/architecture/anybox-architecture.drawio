        <mxCell id="commit" value="&lt;div style=&quot;text-align:left;line-height:1.45;color:#172B4D;&quot;&gt;&lt;div style=&quot;font-size:21px;font-weight:700;color:#356AE6;&quot;&gt;07  成功原子结算&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#526581;margin-top:3px;&quot;&gt;harness.state → Local SQLite&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:10px;&quot;&gt;completed + 完整对话节点&lt;br&gt;+ resultNodeId + 终态事件&lt;br&gt;父节点固定为准入时的起点&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#172B4D;fontSize=16;align=left;verticalAlign=middle;spacing=16;fillColor=#ECF5EF;strokeColor=#CDD7E4;strokeWidth=1.2;" vertex="1" parent="1">
