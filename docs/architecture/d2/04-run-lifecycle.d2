# Successful native run with a tool round. Repeated exchanges are abbreviated.
vars: {d2-config: {theme-id: 0; pad: 48}}
style.fill: "#F8FAFC"
title: "RUN / 从接受到资源退出的执行时序\n成功路径与取消、恢复边界 · 04 / 04" {
  shape: text
  near: top-center
  style: {font-size: 32; bold: true; font-color: "#0F172A"}
}
sequence: "单次 Run：含一轮工具调用，省略重复模型交换" {
  shape: sequence_diagram
  client: "客户端 / HTTP" {style: {fill: "#DBEAFE"; stroke: "#2563EB"; font-size: 20}}
  run: "Run / 准入" {style: {fill: "#DBEAFE"; stroke: "#2563EB"; font-size: 20}}
  session: "Session / 业务库" {style: {fill: "#FEF3C7"; stroke: "#B45309"; font-size: 20}}
  runtime: "RunRuntime" {style: {fill: "#CCFBF1"; stroke: "#0F766E"; font-size: 20}}
  program: "协议 Loop / Models" {style: {fill: "#CCFBF1"; stroke: "#0F766E"; font-size: 20}}
  worker: "Computer Operations / worker" {style: {fill: "#CCFBF1"; stroke: "#0F766E"; font-size: 20}}
  admission: "01 / 幂等检查、准备与接受" {
    client -> run: "startRun(sessionId, parentNodeId, idempotencyKey)"
    run -> session: "优先查询已接受幂等结果"
    run -> program: "未接受时：固定 Prompt / 协议代 / 配置，准备 program"
    run -> session: "接受事务：复核协议与父引用，固定资源和初始化"
    run -> runtime: "同步移交 PreparedRunProgram；此后由 Runtime 清理"
    run -> client: "返回已接受 Run；HTTP 结束不等于 Run 结束" {style.stroke-dash: 4}
  }
  model: "02 / 原生模型交换；每次 perform 均先存意图再启动" {
    runtime -> program: "execute(RunHost)"
    program -> runtime: "perform(模型操作描述, start)"
    runtime -> session: "持久化增量请求意图 / operation ID"
    runtime -> program: "检查停止 → 同步 start 并登记句柄"
    program -> runtime: "原生结果；等待 result 与 done / 实际退出" {style.stroke-dash: 4}
    runtime -> session: "持久化响应观察 / checkpoint / resume cursor"
    runtime -> program: "返回原生结果，由 Loop 决定工具或结束" {style.stroke-dash: 4}
  }
  tools: "03 / 若有工具调用：批次预检、耐久声明、执行与观察" {
    program -> runtime: "executeTools(完整批次)"
    runtime -> session: "固定批次 / owner / 操作意图与声明"
    runtime -> worker: "按需准备固定工作区；提交 operation ID"
    worker -> worker: "耐久接纳 → 执行；独占 Run 进程 scope"
    worker -> runtime: "原结果 + 本次调用实际退出" {style.stroke-dash: 4}
    runtime -> session: "保存真实工具观察与资源引用"
    runtime -> program: "返回工具结果；Loop 发起下一增量模型交换" {style.stroke-dash: 4}
  }
  finish: "04 / Loop 得出结论后：关闭资源，再原子结算" {
    program -> runtime: "最终结论" {style.stroke-dash: 4}
    runtime -> worker: "持久化清理操作；close Run scope"
    worker -> runtime: "终止并等待全部进程组；耐久清理结果" {style.stroke-dash: 4}
    runtime -> program: "close()；等待模型 execution 退出"
    runtime -> session: "记录清理事实；成功 Run / 节点 / 链节 / 终态同事务"
    session -> client: "HTTP/SSE 查询或通知：终态与完整节点" {style.stroke-dash: 4}
  }
}
note: "实线 = 发起操作；虚线 = 返回或通知；Loop 与 Models、Operations 与 worker 为压缩显示的两个参与方。\n取消：关闭新操作准入，取消并等待已接受调用；保留真实观察，清理失败不创建成功节点。\n恢复：Runtime 异常退出后，仅有恢复凭证且模型响应已保存的 Run 可查回原 worker 操作；model-pending 不自动重发。" {
  shape: text
  near: bottom-center
  style: {font-size: 18; font-color: "#475569"}
}
