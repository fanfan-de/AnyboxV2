# Package boundaries and data ownership; not a complete dependency graph.
vars: {d2-config: {layout-engine: elk; theme-id: 0; pad: 48}}
direction: down
style.fill: "#F8FAFC"
classes: {
  group: {style: {fill: "#FFFFFF"; stroke: "#CBD5E1"; border-radius: 16; font-size: 22}}
  service: {style: {fill: "#DBEAFE"; stroke: "#2563EB"; border-radius: 10; font-size: 20}}
  runtime: {style: {fill: "#CCFBF1"; stroke: "#0F766E"; border-radius: 10; font-size: 20}}
  data: {shape: cylinder; style: {fill: "#FEF3C7"; stroke: "#B45309"; font-size: 18}}
}
title: "MODELS / 可复用的模型执行模块\npackages/models · 安装在执行端根 · 03 / 04" {
  shape: text
  near: top-center
  style: {font-size: 32; bold: true; font-color: "#0F172A"}
}
host: "Anybox Harness / 受信宿主" {
  class: group
  settings: "Web 配置 → harness.http\nProvider / Connection / Key / 参数" {class: service}
  loop: "协议 Agent 绑定与 Loop\n准备 execution / 增量交换" {class: service}
  session: "Session\n保存可恢复原生记录与资源引用\n浏览器仅接收展示投影" {class: data}
}
package: "@anybox/models / 独立通用 Nya 包" {
  class: group
  api: "Models 协调组件\nmodels / models.settings\nmodels.protocols / models.source-data" {class: service}
  configuration: "models.store / JSON 提供方\nProvider + Model 统一定义\nConnection → ModelConfiguration\n版本 / 来源 / historyScopeEpoch" {class: data}
  vault: "models.vault / 系统凭据\nmacOS Keychain / Windows Credential Manager\nLinux Secret Service" {class: data}
  execution: "NativeExecution / 私有运行期\n固定配置快照 · 每次初始化读取 Key\n可变原生上下文 · cancel / done" {class: runtime}
  drivers: "四种可替换原生协议组件\nResponses / Chat Completions\nAnthropic Messages / Gemini Interactions" {class: runtime}
  catalog: "models.catalog / 接纳调度\n启动来源选择 / 后台 ETag 刷新" {class: service}
  source: "models.catalog-source\n匿名目录请求与规范化" {class: service}
  cache: "models.catalog-cache\n独占 SQLite / 内存后备\n另有经校验的随包快照" {class: data}
  api -> configuration: "读取 / 原子修订 / 来源账本"
  api -> vault: "凭据意图 → 写 Key → 提交引用"
  api -> execution: "openNative / 管理所有权"
  execution -> drivers: "固定协议代 / 原生请求与结果"
  catalog -> source: "获取公开定义"
  catalog -> cache: "缓存 / 启动恢复"
  catalog -> api: "source-data 原子接纳\n补齐缺失 baseline"
}
remote: "外部来源" {
  class: group
  providers: "模型服务 API\n文本 / 工具 / 图片 / 流式输出" {shape: cloud; style: {fill: "#EDE9FE"; stroke: "#7C3AED"; font-size: 20}}
  directory: "models.dev\n公开模型目录" {shape: cloud; style: {fill: "#EDE9FE"; stroke: "#7C3AED"; font-size: 20}}
}
host.settings -> package.api: "models.settings"
host.loop -> package.api: "list / get / openNative"
host.loop -> package.execution: "受管原生交换"
host.loop -> host.session: "经 RunHost / Runtime 交回记录"
package.drivers -> remote.providers: "协议 HTTP"
package.source -> remote.directory: "匿名 HTTPS / ETag"
note: "实线表示调用或数据流。Models 不导入项目 src/，不执行宿主工具，也不维护 Session 对话树。\n执行只读取已保存配置；目录刷新不修改已有配置或在途 execution。Session.modelId 指向 ModelConfiguration。\nmodels.generateText() 已提供单次纯文本生成，仍归 Models 组件；JSON 仅保存非秘密配置，Key 只进系统 Vault。" {
  shape: text
  near: bottom-center
  style: {font-size: 18; font-color: "#475569"}
}
