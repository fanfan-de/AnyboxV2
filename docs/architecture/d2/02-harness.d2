# Behavioral collaboration view: arrows are calls, not a complete injection graph.
vars: {d2-config: {layout-engine: elk; theme-id: 0; pad: 48}}
direction: down
style.fill: "#F8FAFC"
classes: {
  group: {style: {fill: "#FFFFFF"; stroke: "#CBD5E1"; border-radius: 16; font-size: 22}}
  service: {style: {fill: "#DBEAFE"; stroke: "#2563EB"; border-radius: 10; font-size: 20}}
  runtime: {style: {fill: "#CCFBF1"; stroke: "#0F766E"; border-radius: 10; font-size: 20}}
  data: {shape: cylinder; style: {fill: "#FEF3C7"; stroke: "#B45309"; font-size: 18}}
}
title: "HARNESS SERVER / 核心协作与资源归属\n同一执行端 Nya 根 · 02 / 04" {
  shape: text
  near: top-center
  style: {font-size: 32; bold: true; font-color: "#0F172A"}
}
entry: "harness.http / 受信 API 门面\n每次请求获取当前服务代" {class: service}
run: "Run / harness.runs\n幂等检查 · 显式 parentNodeId\n准备 · 接受 · 取消 · 等待" {class: service}
prompts: "Prompt + Agent Prompt\n发布版本 · 绑定 · 本轮模板" {class: service}
registry: "Protocol Agent 注册表与四种绑定\n固定驱动代租约\n准备 PreparedRunProgram" {class: service}
runtime: "RunRuntime\n意图 → 启动 → 等待 result / done\n观察 → 清理 → 结算" {class: runtime}
loop: "PreparedRunProgram / 协议 Loop\nResponses · Chat · Anthropic · Gemini\n解释原生结果与续轮决策" {class: runtime}
models: "Models / NativeExecution\n私有凭据 · 可变原生上下文\n请求退出后提交候选上下文" {class: runtime}
sessions: "Session\nharness.sessions / harness.session-runs\n会话树 · Run · 原生记录 · resume cursor" {class: service}
assets: "独立资源组件\nProjects / Project Files / Image Assets\n目录身份 / 文本快照 / 图片原字节" {class: service}
db: "local-storage / 业务 SQLite\n各组件登记自己的迁移域\n成功 Run + 节点 + 链节 + 终态同事务" {class: data}
operations: "Computer Operations\n工具声明 / owner epoch\n耐久取消与 scope 清理" {class: runtime}
placement: "Computers + Workspaces\n实例确认 / pins / 固定项目绑定\n本机实例提供方" {class: service}
proxy: "computer.worker / 本机客户端\n回环 HTTP 观察与查询" {class: service}
worker: "独立 worker 根\n执行账本 · 工具调用 · Run scope\nBash / Apply Patch / Processes / Files" {
  class: runtime
  style.stroke-dash: 5
}
entry -> run: "start / cancel / wait"
entry -> sessions: "历史与事件查询"
run -> prompts: "固定提示词"
run -> registry: "准备 program"
run -> sessions: "复核父引用 / 接受"
run -> runtime: "同步移交 program"
registry -> models: "openNative / 恢复"
runtime -> loop: "execute(RunHost) / close()"
loop -> models: "经 perform 受管交换"
runtime -> sessions: "意图 / 观察 / 结算"
runtime -> operations: "executeTools / close scope"
sessions -> assets: "准备与原子保留引用"
sessions -> db: "历史事实"
assets -> db: "领域数据"
sessions -> operations: "接受时固定声明 / owner"
operations -> placement: "按需准备 binding"
operations -> proxy: "派发 / 查询 / 取消"
proxy -> worker: "受信回环 HTTP"
note: "本图箭头表示协作调用，省略部分存储与 inject 依赖。RunRuntime 仅注入 Session Run 端口和 Computer Operations。\nAgent 定义是组合根传入的只读配置；协议 Loop / PreparedRunProgram 是受管实现，不是额外 Nya Context。\n资源实际退出后才结算；取消保留真实工具观察与部分补丁事实，清理失败不创建成功节点。" {
  shape: text
  near: bottom-center
  style: {font-size: 18; font-color: "#475569"}
}
