{
  "name": "anybox-v2",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "check": "npm run typecheck && npm test",
    "predemo": "npm run build",
    "demo": "node examples/demo.mjs",
    "predemo:agent": "npm run build",
    "demo:agent": "node examples/agent-kernel-demo.mjs",
    "predemo:harness": "npm run build",
    "demo:harness": "node examples/agent-harness-demo.mjs",
    "predemo:application": "npm run build",
    "demo:application": "node examples/agent-application-demo.mjs",
    "prestart:agent": "npm run build",
    "start:agent": "node examples/agent-application-host.mjs",
    "prestart": "npm run build",
    "start": "node examples/host.mjs",
    "nya:build": "npm --prefix ../NyaCore run build",
    "nya:watch": "npm --prefix ../NyaCore run dev:core"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  }
}
