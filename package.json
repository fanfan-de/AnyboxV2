{
  "name": "anybox-v2",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "node scripts/build-workspaces.mjs",
    "anybox": "npm run build && node packages/distribution/dist/entrypoints/anybox-main.js",
    "web": "npm run client",
    "web:local": "npm run build && node packages/distribution/dist/entrypoints/serve.js",
    "typecheck": "node scripts/build-workspaces.mjs --typecheck",
    "test": "npm run build && node --test tests/*.test.mjs packages/*/tests/*.test.mjs",
    "check": "npm run typecheck && npm test",
    "nya:build": "npm --prefix ../NyaCore run build",
    "nya:watch": "npm --prefix ../NyaCore run dev:core",
    "harness:server": "npm run build && node packages/distribution/dist/entrypoints/anybox-main.js harness-server",
    "harness:server:init": "npm run build && node packages/distribution/dist/entrypoints/anybox-main.js harness-server init",
    "harness": "npm run harness:server",
    "harness:init": "npm run harness:server:init",
    "client": "npm run build && node packages/distribution/dist/entrypoints/anybox-main.js client",
    "computer:worker": "npm run build && node packages/distribution/dist/entrypoints/anybox-main.js computer-worker",
    "release": "node scripts/release.mjs",
    "artifacts:build": "node scripts/build-application-artifacts.mjs",
    "desktop:dev": "npm run build && node scripts/build-desktop-native.mjs && node scripts/desktop-run.mjs",
    "desktop:package": "node scripts/desktop-package.mjs",
    "desktop:make": "node scripts/desktop-package.mjs --make",
    "desktop:smoke": "npm run build && node scripts/build-desktop-native.mjs && node scripts/desktop-run.mjs --smoke"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/core": "8.0.1",
    "@electron-forge/maker-dmg": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/plugin-fuses": "8.0.1",
    "@electron/fuses": "2.1.3",
    "@types/mdast": "4.0.4",
    "@types/node": "22.20.1",
    "@types/picomatch": "4.0.3",
    "electron": "44.5.1",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "@nya/core": "file:../NyaCore/packages/core"
  },
  "main": "packages/distribution/dist/entrypoints/desktop-main.js",
  "workspaces": [
    "packages/*"
  ]
}
